<?php
session_start();
require_once "db.php";
require_once "flash.php";

date_default_timezone_set('Asia/Dhaka');

$user_id = $_GET['id'] ?? '';
$batch   = $_GET['batch'] ?? '';

if(empty($user_id) || empty($batch)){
    $_SESSION['error'] = "No batch selected.";
    header("Location: my_exams.php");
    exit;
}

/* =========================
   FETCH EXAM END TIME
========================= */
$stmt = $conn->prepare("SELECT exam_date, end_time FROM authority_tbl WHERE batch=?");
$stmt->bind_param("i", $batch);
$stmt->execute();
$exam_details = $stmt->get_result()->fetch_assoc();
$stmt->close();

if(!$exam_details){
    die("Exam schedule not found.");
}

// Remove microseconds from time (12:19:00.000000 → 12:19:00)
$clean_end_time = explode('.', $exam_details['end_time'])[0];

// Combine date + time
$exam_end_datetime = $exam_details['exam_date'] . ' ' . $clean_end_time;


/* =========================
   FETCH QUESTIONS
========================= */
$stmt = $conn->prepare("SELECT * FROM question_set WHERE batch=? ORDER BY id ASC");
$stmt->bind_param("i", $batch);
$stmt->execute();
$result = $stmt->get_result();
$questions = $result->fetch_all(MYSQLI_ASSOC);
$stmt->close();
?>

