<!-- =========================
     COUNTDOWN SCRIPT
========================= -->
<script>
const examEndTime = new Date("<?= $exam_end_datetime ?>".replace(" ", "T")).getTime();
const countdownElement = document.getElementById("countdown");
const examForm = document.querySelector("form");

const timer = setInterval(function () {

    const now = new Date().getTime();
    const distance = examEndTime - now;

    if (distance <= 0) {
        clearInterval(timer);
        countdownElement.innerHTML = "Time Over!";
        countdownElement.classList.remove("text-warning");
        countdownElement.classList.add("text-danger");

        alert("Exam time is over! Submitting automatically.");
        examForm.submit();
        return;
    }

    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

    countdownElement.innerHTML =
        String(hours).padStart(2, '0') + ":" +
        String(minutes).padStart(2, '0') + ":" +
        String(seconds).padStart(2, '0');

}, 1000);
</script>

